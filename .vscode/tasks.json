{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with ACME 1.01mp",
            "type": "process",
            "command": "C:\\Users\\martin\\programme\\acme\\Release\\ACME.exe",
            "args": [
                "-f", "cbm",
                "--cpu", "6510",
                "-o", "build\\roboter.prg",
                "src\\main.asm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Debug with ACME PDB Monitor + VICE",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Start-Process -FilePath 'C:\\Users\\martin\\programme\\acme\\VICEPDBMonitor\\bin\\Release\\VICEPDBMonitor.exe' -ArgumentList '\"${workspaceFolder}\\Test.pdb\"'; Start-Process -FilePath 'C:\\Users\\martin\\programme\\GTK3VICE-3.10-win64\\bin\\x64sc.exe' -ArgumentList @('-pal', '-autostartprgmode', '1', '-remotemonitor', '\"${workspaceFolder}\\build\\roboter.prg\"')"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build with ACME 1.01mp",
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
