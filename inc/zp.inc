; zp.inc - Zeropage and RAM variables
ptr0        = $02
ptr1        = $04
ptr2        = $06
cnt         = $08
tmp0        = $0A
tmp1        = $0B
tmp2        = $0C
tmp3        = $0D
frame       = $0E
cur_x       = $11
cur_y       = $12
cur_col     = $13
joy_now     = $14
joy_prev    = $15
joy_new     = $16
joy_rep     = $17
key_now     = $18
key_prev    = $19
key_new     = $1A
key_rep     = $1B
robot_tx    = $1C
robot_ty    = $1D
box_tx      = $1E
box_ty      = $1F
goal_tx     = $20
goal_ty     = $21
level_no    = $22
sound_timer = $28
mouse_raw_x = $2E
mouse_raw_y = $2F
mouse_x_lo  = $30            ; logical screen x, low byte
mouse_x_hi  = $31            ; logical screen x, high byte (0 or 1)
mouse_y     = $32            ; logical screen y (0..199)
mouse_btn   = $33
mouse_current = $34
mouse_click = $35
key_repeat  = $36
key_shift   = $37
editor_count = $38           ; number of commands in the planning list (0..99)
insert_pos  = $39            ; insertion slot, 0..editor_count
scroll_offset = $3A          ; first command shown in the list
selected_command = $3B       ; temporary palette command index
hover_command = $3C          ; palette command currently shown in the help row
selected_index = $3D         ; absolute index of the highlighted command
selection_origin = $3E       ; index needed to undo unconfirmed reordering
selection_active = $3F
delete_pending = $40
move_temp   = $41
selection_target = $42
refresh_other = $45          ; second list row to redraw ($FF = none)
robot_dir   = $44            ; ROBOT_DIR_*: 0 right, 1 left, 2 up, 3 down
win_x       = $5D            ; draw_window (run.asm): outer frame position/size
win_y       = $5E
win_w       = $5F
win_h       = $60
program     = $0300

map_work    = $0200
lock_count  = $24            ; number of lock/door pairs of the loaded level (mapdata.asm)
run_item    = $25            ; what is carried / was last carried: 0 package, 1 key (run.asm)
goal_count  = $23            ; number of goal fields of the loaded level (mapdata.asm)
; --- World map, worlds and plan/run hand-over (world.asm)
run_to_map    = $6C             ; set by run_mode: won level left with Space
plan_exit     = $6D             ; set in plan mode: return to the world map
wm_cx         = $70             ; robot cell on the world map
wm_cy         = $71
wm_px         = $72             ; robot pixel x on the screen (16 bit, $72/$73)
wm_py         = $74             ; robot pixel y on the screen
wm_vx         = $75             ; movement per frame (signed pixels)
wm_vy         = $76
wm_steps      = $77             ; movement frames left
wm_confirm    = $78             ; 1 while "Really quit?" is shown
wm_node       = $79             ; node under the robot ($FF = none)
world_cur     = $7A             ; current world
world_first   = $7B             ; its first level (index into plan_level_table)
world_nlev    = $7C             ; its number of levels
world_rec     = $7D             ; its record ($7D/$7E)
wm_map        = $80             ; its overview map ($80/$81)
wm_nodes      = $82             ; its node list ($82/$83)
wm_sx         = $84             ; put_cell: screen column / row / first character
wm_sy         = $85
wm_ch         = $86
wm_tmp        = $87
wm_tmp2       = $88
wm_dx         = $89             ; loop counters while drawing the map
wm_dy         = $8A
wm_ix         = $8B             ; wm_cell scratch
wm_iy         = $8C
wm_prevx      = $8D             ; cell the robot came from (gate exit position)
wm_prevy      = $8E
